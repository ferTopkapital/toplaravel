APP_NAME="Top Kapital"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Mexico_City
APP_URL=http://toplaravel.localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=13

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
# Base de datos COMPARTIDA con la app Yii2 (C:\dev	opkapital).
# No correr migrate:fresh ni migraciones que alteren tablas del negocio.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=topkapital
DB_USERNAME=
DB_PASSWORD=

# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
# ---- Parametros regulados (ver config/topkapital.php) ----
# El valor normativo son 5 minutos. En LOCAL se sube para no pelear
# con la sesion mientras se desarrolla. Nunca subirlo en produccion.
SESSION_IDLE_MINUTES=30

SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# En LOCAL el correo va al log (storage/logs/laravel.log), NO se envia.
# Cambiar a smtp solo cuando se quiera probar el envio de verdad, y con
# cuidado: las credenciales de contacto@topkapital.com mandan correo real.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="contacto@topkapital.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"